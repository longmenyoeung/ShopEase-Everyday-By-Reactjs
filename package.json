{
  "name": "shop-everyday-storefront",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src public/data/catalog.json scripts tests *.js *.json *.md index.html",
    "test:e2e": "playwright test",
    "pretest:production": "npm run build",
    "test:production": "playwright test --config playwright.production.config.js"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "vite": "^6.0.5"
  }
}
